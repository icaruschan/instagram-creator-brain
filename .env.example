NOTION_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
APIFY_TOKEN=
BACKUP_APIFY_TOKEN=
IG_BRAIN_JEV_MODEL=typesafe/jev-1.13
IG_BRAIN_MINIMAX_MODEL=minimax/minimax-m3
IG_BRAIN_GEMINI_MODEL=gemini-3.8-flash
IG_BRAIN_REELS_PER_CREATOR=3
IG_BRAIN_CREATORS_PER_SCAN=5
IG_BRAIN_DEEP_ANALYSIS_LIMIT=5
# Guardrails (2026-11-12)
IG_BRAIN_ACTIVE_ACCOUNTS=Yuna
IG_BRAIN_SKIP_TRIAL_REELS=true
IG_BRAIN_SCAN_BUDGET_USD=1.00
IG_BRAIN_ACTION_BUDGET_USD=0.25
IG_BRAIN_MIN_PERFORMANCE_FOR_ANALYSIS=60
IG_BRAIN_MIN_PRIORITY_FOR_ANGLES=60
# Video analysis (2026-11-12): openrouter (Qwen Omni, default) | gemini
VIDEO_ANALYSIS_PROVIDER=openrouter
VIDEO_ANALYSIS_OPENROUTER_MODEL=qwen/qwen3.8-omni-flash
VIDEO_ANALYSIS_FALLBACK=none
VIDEO_ANALYSIS_SEND_MODE=data-url
VIDEO_ANALYSIS_TIMEOUT_MS=120000
VIDEO_ANALYSIS_MAX_ATTEMPTS=3
VIDEO_ANALYSIS_REASONING_MAX_TOKENS=1024
VIDEO_ANALYSIS_MAX_INLINE_MB=40
# Optional cost-estimate overrides (USD): IG_BRAIN_COST_APIFY_REEL_RESULT, IG_BRAIN_COST_APIFY_TRANSCRIPT,
# IG_BRAIN_COST_JEV_CALL, IG_BRAIN_COST_GEMINI_ANALYSIS, IG_BRAIN_COST_OPENROUTER_VIDEO_ANALYSIS, IG_BRAIN_COST_MINIMAX_CALL
# IG_BRAIN_COST_LOG_FILE=.tmp/ig-brain-cost-log.jsonl   (empty string disables the file log)
